# LifePilot AI — Environment Configuration Example
# Copy this file to .env and provide your AWS credentials if testing live Amazon Bedrock.
# If no AWS credentials are provided, LifePilot AI will run in intelligent Local Simulation Mode.

# Server Configuration
PORT=3000

# AWS Configuration for Amazon Bedrock
# Region where Bedrock foundation models are enabled (e.g., us-east-1, us-west-2, eu-central-1)
AWS_REGION=us-east-1

# AWS IAM Credentials (requires bedrock:InvokeModel and bedrock:InvokeModelWithResponseStream permissions)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Optional: AWS Session Token (if using temporary credentials or AWS Academy / Learner Lab)
# AWS_SESSION_TOKEN=your_aws_session_token_here

# Bedrock Model ID
# Recommended models:
# - anthropic.claude-3-5-sonnet-20240620-v1:0 (Default, high intelligence)
# - anthropic.claude-3-haiku-20240307-v1:0 (Fast & cost-effective)
# - amazon.nova-micro-v1:0 (AWS native high speed)
# - amazon.nova-lite-v1:0 (AWS native multimodal/reasoning)
# - meta.llama3-70b-instruct-v1:0 (Meta Llama on Bedrock)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
